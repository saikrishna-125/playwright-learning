{
  "name": "playwright-basics",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "tests": "playwright test tests/UsingAPIs.spec.js",
    "test": "playwright test --config=playwright.config1.js --workers=8 --grep=APP --project=chromium",
    "test:allure": "npm run allure:clean && playwright test --config=playwright.config1.js --workers=8 --grep=APP --project=chromium",
    "test:allure:all": "npm run allure:clean && playwright test --config=playwright.config1.js --workers=8 --project=chromium",
    "test:allure:api": "npm run allure:clean && playwright test tests/UsingAPIs.spec.js --config=playwright.config1.js --workers=1 --project=chromium",
    "allure:clean": "node -e \"require('fs').rmSync('allure-results', { recursive: true, force: true }); require('fs').rmSync('allure-report', { recursive: true, force: true })\"",
    "allure:generate": "allure generate allure-results --clean -o allure-report",
    "allure:open": "allure open allure-report",
    "allure:serve": "allure serve allure-results"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@azure/identity": "^4.13.1",
    "@azure/playwright": "^1.1.6",
    "@cucumber/cucumber": "^13.2.0",
    "@playwright/test": "^1.61.1",
    "@types/node": "^26.1.1",
    "allure-commandline": "^2.43.0",
    "allure-playwright": "^3.10.2",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "exceljs": "^4.4.0"
  }
}
